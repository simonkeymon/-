<!doctype html><html lang="zh"><head><meta charset="utf-8"><title>AI 简史 · 蓝图</title>
<link href="../style-refs/fonts/c_blueprint.css" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
html,body{width:1920px;height:1080px;overflow:hidden;background:#0f3f86}
body{position:relative;color:#eaf3ff;font-family:'Noto Sans SC',sans-serif}
#bg{position:absolute;inset:0;background-color:#0f3f86;
 background-image:radial-gradient(ellipse at 40% 40%,rgba(255,255,255,.08),transparent 60%),
  linear-gradient(rgba(255,255,255,.18) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.18) 1px,transparent 1px),
  linear-gradient(rgba(255,255,255,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.07) 1px,transparent 1px);
 background-size:100% 100%,120px 120px,120px 120px,24px 24px,24px 24px}
svg{overflow:visible}
svg text{fill:#eaf3ff;stroke:none;font-family:'Noto Sans SC'}
svg .m{font-family:'IBM Plex Mono'}
svg .hw{font-family:'Ma Shan Zheng'}
svg text.y{fill:#ffe27a}
svg .ys{stroke:#ffe27a}
svg .chess{font-family:'DejaVu Sans'}
.p,.spin{transform-box:fill-box;transform-origin:center}
.full{position:absolute;left:0;top:0}
.scene{position:absolute;inset:0}
.inner{position:absolute;inset:0;transform-origin:50% 42%}
.year{position:absolute;top:120px;left:92px;font-family:'IBM Plex Mono';font-weight:600;font-size:190px;line-height:1;letter-spacing:4px;color:transparent;-webkit-text-stroke:2px #eaf3ff}
.title{position:absolute;top:330px;left:96px;font-weight:700;font-size:84px;letter-spacing:6px;white-space:nowrap}
.title.sm{font-size:66px;letter-spacing:3px;top:342px}
.note{position:absolute;top:450px;left:100px;font-family:'Ma Shan Zheng';color:#ffe27a;font-size:40px;white-space:nowrap;rotate:-2deg;padding:0 8px}
.spec{position:absolute;left:96px;top:560px;width:660px;font-size:24px;line-height:1.8;font-weight:300;border:1.5px dashed rgba(234,243,255,.7);padding:20px 26px}
.spec .k{font-family:'IBM Plex Mono';font-size:16px;letter-spacing:2px;opacity:.7;display:block;margin-bottom:6px}
.art{position:absolute;left:760px;top:110px;width:1080px;height:660px}
.art>svg{position:absolute;left:0;top:0}
.lb{position:absolute;white-space:nowrap}
.hand{font-family:'Ma Shan Zheng';color:#ffe27a}
.mono{font-family:'IBM Plex Mono'}
.center{position:absolute;left:50%;translate:-50% 0;white-space:nowrap;text-align:center}
#hud{opacity:0}
#tag{position:absolute;top:84px;left:96px;font-family:'IBM Plex Mono';font-size:20px;letter-spacing:3px;opacity:.85}
#tl{position:absolute;left:96px;width:960px;bottom:92px;height:60px;font-family:'IBM Plex Mono';font-size:17px}
#tl .bar{position:absolute;top:14px;left:0;right:0;border-top:1.5px solid rgba(234,243,255,.55)}
#tl .fill{position:absolute;top:13px;left:0;border-top:3px solid #eaf3ff}
#tl .t{position:absolute;top:6px;height:18px;border-left:2px solid #eaf3ff}
#tl .l{position:absolute;top:30px;width:60px;margin-left:-30px;text-align:center;opacity:.7}
#tl .l.cur{color:#ffe27a;opacity:1}
#tl .on{position:absolute;top:1px;width:28px;height:28px;margin-left:-14px;border:2.5px solid #ffe27a;border-radius:50%;box-shadow:0 0 12px rgba(255,226,122,.5)}
#tb{position:absolute;right:52px;bottom:52px;width:760px;height:170px;border-top:3px solid #eaf3ff;border-left:3px solid #eaf3ff;display:grid;
 grid-template-columns:150px 1fr 150px 140px;grid-template-rows:1fr 1fr 1fr;font-size:19px;background:rgba(15,63,134,.6)}
#tb div{border-right:1px solid rgba(234,243,255,.7);border-bottom:1px solid rgba(234,243,255,.7);padding:8px 12px;display:flex;align-items:center;white-space:nowrap;overflow:hidden}
#tb .h{font-family:'IBM Plex Mono';font-size:14px;letter-spacing:2px;opacity:.75}
#tb .big{font-weight:700;font-size:26px}
#scan{position:absolute;top:0;bottom:0;width:3px;margin-left:-1px;background:#fff;box-shadow:0 0 18px 6px rgba(170,215,255,.85);opacity:0}
#scan::before{content:'';position:absolute;top:0;bottom:0;right:3px;width:260px;background:linear-gradient(90deg,transparent,rgba(200,230,255,.16))}
#fade{position:absolute;inset:0;background:#030b1a;opacity:0}
</style></head><body>
<div id="bg"></div>
<svg width="0" height="0" style="position:absolute"><defs>
<marker id="ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto" style="overflow:visible"><path d="M0,0 L10,5 L0,10 z" fill="#eaf3ff"/></marker>
<marker id="ar2" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto"><path d="M10,0 L0,5 L10,10 z" fill="#eaf3ff"/></marker>
<marker id="ary" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="12" markerHeight="12" markerUnits="userSpaceOnUse" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#ffe27a"/></marker>
</defs></svg>
<div id="global">
<svg class="full" width="1920" height="1080" fill="none" stroke="#eaf3ff">
<rect class="d" data-t="0.2" data-d="1.8" x="40" y="40" width="1840" height="1000" stroke-width="3"/>
<rect class="d" data-t="0.6" data-d="1.8" x="52" y="52" width="1816" height="976" stroke-width="1" stroke-opacity=".6"/>
</svg>
</div>
